{
  "name": "@aio/framework",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm run test && python3 tools/check-sources.py && python3 tools/check-assets.py && python3 tools/test-check-sources.py && python3 tools/test-check-assets.py && python3 tools/test-build-manifest.py",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "^5.7.2",
    "vitepress": "^2.0.0-alpha.19",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22"
  }
}
