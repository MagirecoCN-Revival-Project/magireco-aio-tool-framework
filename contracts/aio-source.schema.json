{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/MagirecoCN-Revival-Project/magireco-aio-tool-framework/contracts/aio-source.schema.json",
  "title": "AIO 上游接线契约",
  "description": "每个上游仓库一份，说明它如何成为框架的一个插件（或明确不接入）。分类由人写死，不由脚本推断。",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "repo", "publish", "integration", "license_note"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "repo": { "type": "string", "pattern": "^[A-Za-z0-9._-]+/[A-Za-z0-9._-]+$" },
    "publish": {
      "enum": ["allowed", "forbidden"],
      "description": "是否允许出现在公开面。必须与 repository-policy.json 一致"
    },
    "integration": {
      "enum": ["plugin", "data", "proxy", "link", "none"],
      "description": "plugin=包装成框架插件；data=只作为资源/交叉表来源，不出现在运行时；proxy=反代其既有部署；link=门户放链接；none=不接入"
    },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pluginId", "isolation", "capabilities"],
      "description": "integration=plugin 时必填",
      "properties": {
        "pluginId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
        "isolation": {
          "enum": ["inline", "iframe"],
          "description": "iframe = 该运行时靠全局变量活着（cocos2d 的 window.cc、Cubism 的 window.Live2DCubismCore），必须独占 realm"
        },
        "isolation_reason": { "type": "string" },
        "usesWebGL": { "type": "boolean" },
        "capabilities": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "accepts"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9]*)+$" },
              "accepts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": ["character","sprite","live2d","model3d","voice","scenario","card","item","bgm","image"]
                }
              },
              "title": { "type": "string" }
            }
          }
        }
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix"],
      "description": "该仓库贡献到资源面的资产。前缀在全局唯一。",
      "properties": {
        "prefix": { "type": "string", "pattern": "^[a-z0-9-]+/$" },
        "approx_files": { "type": "integer", "minimum": 0 },
        "approx_bytes": { "type": "integer", "minimum": 0 },
        "note": { "type": "string" }
      }
    },
    "mount": {
      "type": "string",
      "pattern": "^/([a-z0-9-]+/)*$",
      "description": "仅 integration=proxy 使用：反代挂载路径。publish=forbidden 时禁止出现"
    },
    "license_note": { "type": "string" },
    "phase": { "type": "integer", "minimum": 0, "maximum": 6 }
  }
}
