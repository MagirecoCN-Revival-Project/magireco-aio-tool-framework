{
  "id": "example-sprite-mirror",
  "repo": "example-org/example-sprite-mirror",
  "publish": "allowed",
  "integration": "plugin",
  "phase": 1,
  "plugin": {
    "pluginId": "sprite-viewer",
    "isolation": "iframe",
    "isolation_reason": "cocos2d-html5 靠 window.cc 活着，与任何其它 cocos 运行时同 realm 会互相覆盖",
    "usesWebGL": true,
    "capabilities": [
      {
        "id": "sprite.show",
        "accepts": [
          "sprite",
          "character"
        ],
        "title": "显示战斗精灵"
      }
    ]
  },
  "assets": {
    "prefix": "sprite/",
    "approx_files": 8100,
    "approx_bytes": 3326083072,
    "note": "示例：老引擎靠全局变量活着，必须独占 realm。"
  },
  "license_note": "素材归各自版权方，全部外置到资源面。"
}
