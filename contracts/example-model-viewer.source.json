{
  "id": "example-model-viewer",
  "repo": "example-org/example-model-viewer",
  "publish": "allowed",
  "integration": "plugin",
  "phase": 1,
  "plugin": {
    "pluginId": "model-3d",
    "isolation": "inline",
    "isolation_reason": "three.js 0.182 是 ESM，不污染全局，可与 Pixi 同 realm 共存",
    "usesWebGL": true,
    "capabilities": [
      {
        "id": "model3d.show",
        "accepts": [
          "model3d",
          "character"
        ],
        "title": "查看 3D 模型"
      }
    ]
  },
  "assets": {
    "prefix": "3d/",
    "approx_files": 1200,
    "approx_bytes": 734003200,
    "note": "示例：一个 ESM 的 3D 查看器，inline 即可，wrapper 模式的样板。"
  },
  "license_note": "构造函数本来就是注入式（Record<路径, URL>），所以包装它不需要改上游一行。"
}
