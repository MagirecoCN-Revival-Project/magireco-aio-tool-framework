{
  "id": "example-model-viewer",
  "repo": "CyberNova2333/example-model-viewer",
  "publish": "allowed",
  "integration": "plugin",
  "phase": 1,
  "plugin": {
    "pluginId": "model-3d",
    "isolation": "inline",
    "isolation_reason": "three.js 0.182 是 ESM，不污染全局，可与 Pixi 同 realm 共存",
    "usesWebGL": true,
    "capabilities": [
      {
        "id": "model3d.show",
        "accepts": [
          "model3d",
          "character"
        ],
        "title": "查看 3D 模型"
      }
    ]
  },
  "assets": {
    "prefix": "3d/",
    "approx_files": 1200,
    "approx_bytes": 734003200,
    "note": "沿用其 compress_fbx_gzip 与 *.gz 的 Content-Encoding 约定"
  },
  "license_note": "代码可用；模型素材归版权方，进资源面并支持整片下架。"
}
