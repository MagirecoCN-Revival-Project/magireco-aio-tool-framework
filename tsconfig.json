{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@aio/core": [
        "./packages/core/src/index.ts"
      ],
      "@aio/registry": [
        "./packages/registry/src/index.ts"
      ],
      "@aio/resource": [
        "./packages/resource/src/index.ts"
      ],
      "@aio/kernel": [
        "./packages/kernel/src/index.ts"
      ],
      "@aio/plugin-sdk": [
        "./packages/plugin-sdk/src/index.ts"
      ],
      "@aio/plugin-model-3d": [
        "./packages/plugin-model-3d/src/index.ts"
      ],
      "@aio/capability": [
        "./packages/capability/src/index.ts"
      ],
      "@aio/conformance": [
        "./packages/conformance/src/index.ts"
      ],
      "@aio/plugin-adv": [
        "./packages/plugin-adv/src/index.ts"
      ],
      "@aio/plugin-sprite": [
        "./packages/plugin-sprite/src/index.ts"
      ],
      "@aio/plugin-search": [
        "./packages/plugin-search/src/index.ts"
      ],
      "@aio/plugin-live2d": [
        "./packages/plugin-live2d/src/index.ts"
      ]
    },
    "baseUrl": ".",
    "jsx": "preserve"
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "apps/*/src/**/*.ts",
    "apps/*/src/**/*.tsx",
    "vitest.config.ts"
  ]
}
